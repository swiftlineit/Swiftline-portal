# The 45 MB source dataset is a one-off tool, not a build input: the compact
# files it produces (backend/data/reference/) are committed instead, so nothing
# needs it to run. Regenerate with `npm run build:reference-data` after
# replacing it.
countries+states+cities.json

# Same arrangement for the Harmonized System source: backend/data/reference/
# hs-codes.json is committed, the CSV it was built from is not. Regenerate with
# `npm run build:hs-codes` after replacing it.
harmonized-system.csv

