NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# When true, internal users are newest-login-wins; clients may still use multiple devices.
SINGLE_SESSION_ENFORCED=true
# Server backstop; the browser warns at 15 minutes and signs out after its 1 minute countdown.
SESSION_IDLE_TIMEOUT_MINUTES=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
MAIL_FROM="Swiftline Portal <no-reply@swiftline.example>"
# ses | smtp | noop. Production must be "ses"; the server logs a warning if not.
MAIL_DRIVER=smtp
MAIL_REPLY_TO=support@swiftline.example
# Non-production only: every recipient outside this list is dropped before send.
# Comma-separated exact addresses or "@domain" suffixes.
MAIL_SAFELIST=@swiftline.example
AWS_REGION=ap-south-1
# Leave both empty on EC2/ECS to use the instance role instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=swiftline-portal
# Appended to the SNS subscription URL as ?token=... (SNS cannot send headers).
SES_WEBHOOK_SECRET=replace_with_a_long_random_string
EMAIL_MAX_ATTACHMENT_BYTES=7340032
EMAIL_DRAIN_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
IDEAL_POSTCODES_API_KEY=your-ideal-postcodes-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_ADDRESS_VALIDATION_API_KEY=your-google-address-validation-api-key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# All top-up amounts are in paise. 50000000 = 5,00,000 rupees.
RAZORPAY_MIN_TOPUP_MINOR=1000
RAZORPAY_MAX_TOPUP_MINOR=50000000
# Ceiling per business account per IST day, security deposits excluded.
RAZORPAY_MAX_DAILY_TOPUP_MINOR=50000000
# Minutes an unpaid order keeps holding its share of the daily allowance.
RAZORPAY_TOPUP_PENDING_TTL_MINUTES=30
# Active branch that owns every public online booking in this release.
PUBLIC_BOOKING_BRANCH_ID=
PUBLIC_BOOKING_SESSION_HOURS=24
GOOGLE_OAUTH_CLIENT_ID=

RECAPTCHA_SECRET_KEY=...
RECAPTCHA_ENABLED=false

RECAPTCHA_MIN_SCORE=0.5

AWS_REGION=ap-south-1

STORAGE_DRIVER=s3
S3_BUCKET=swiftline-prod-storage-485141928054-ap-south-1-an
S3_SIGNED_URL_TTL_SECONDS=900
S3_KEY_PREFIX=production


# ALS (Trackmate+) - the carrier behind the DPD label. Only United Kingdom
# destinations request one; every other route ships on Swiftline labels alone.
# Leave ALS_ENABLED=false to book exactly as the portal does without it.
ALS_ENABLED=false
ALS_API_BASE_URL=https://admin.airportlinkservices.com
ALS_COMPANY_ID=
ALS_API_EMAIL=
ALS_API_PASSWORD=
ALS_SERVICE_CODE=DPD UK NEXTDAY
ALS_INR_PER_GBP=
ALS_REQUEST_TIMEOUT_MS=30000

# exchange rate api key
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
