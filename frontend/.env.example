NEXT_PUBLIC_API_URL=http://localhost:5000
# Enable only after the backend tenant migration and isolation gates pass.
NEXT_PUBLIC_OPERATOR_PORTAL_ENABLED=false
# Both optional: leave blank to hide the "Sign in with Google" button / skip captcha
# scoring client-side. Must match the backend's GOOGLE_OAUTH_CLIENT_ID / reCAPTCHA site.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
